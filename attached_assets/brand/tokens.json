{
  "brand": "FRANCIS VALENTE",
  "domain": "francisvalente.com",
  "palette": {
    "ink": {
      "hex": "#0a0a0a",
      "oklch": "oklch(14.5% 0 0)",
      "role": "page background, dark context"
    },
    "panel": {
      "hex": "#1f1f1f",
      "oklch": "oklch(23.9% 0 0)",
      "role": "raised surfaces, hairlines on dark"
    },
    "text": {
      "hex": "#e6e6e6",
      "oklch": "oklch(92.5% 0 0)",
      "role": "primary text on dark"
    },
    "muted": {
      "hex": "#8a8a8a",
      "oklch": "oklch(63.3% 0 0)",
      "role": "secondary text"
    },
    "accent": {
      "hex": "#ff5c00",
      "oklch": "oklch(68.4% 0.212 40.6)",
      "role": "state only: active, focused, copied"
    },
    "light": {
      "hex": "#ffffff",
      "oklch": "oklch(100% 0 0)",
      "role": "light context background"
    }
  },
  "ramps": {
    "neutral": {
      "50": "#f3f3f3",
      "100": "#d5d5d5",
      "200": "#b7b7b7",
      "300": "#9b9b9b",
      "400": "#7f7f7f",
      "500": "#646464",
      "600": "#4b4b4b",
      "700": "#323232",
      "800": "#1c1c1c",
      "900": "#080808"
    },
    "accent": {
      "50": "#ffe0d5",
      "100": "#fec1ab",
      "200": "#fd9f7d",
      "300": "#fd7743",
      "400": "#ff5c00",
      "500": "#cc4a07",
      "600": "#ac3c02",
      "700": "#8b3106",
      "800": "#6e2403",
      "900": "#521801",
      "brandStep": 400
    }
  },
  "type": {
    "display": {
      "family": "Gladiator",
      "weights": [
        "bold (single cut)"
      ],
      "usage": "wordmark and display only, never below ~28px, never UI labels or body"
    },
    "mono": {
      "family": "JetBrains Mono",
      "weights": [
        400,
        500,
        700
      ],
      "usage": "400 body, 500 uppercase tracked labels, 700 headings"
    }
  },
  "rules": {
    "accent": "orange marks the active, the focused and the copied; never decoration",
    "voice": "clinical, imperative, factual; uppercase micro labels; no explainer copy; empty sections are removed, not explained; never use em dashes"
  },
  "contrastWCAG21": {
    "text/ink": 15.86,
    "muted/ink": 5.73,
    "accent/ink": 6.39,
    "text/panel": 13.21,
    "muted/panel": 4.77,
    "accent/panel": 5.32,
    "ink/light": 19.8,
    "muted/light": 3.45,
    "accent/light": 3.1,
    "ink/accent": 6.39,
    "largeTextOnly": [
      "muted/light",
      "accent/light",
      "light/accent"
    ]
  }
}
